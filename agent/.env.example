# Copy to agent/.env and fill. .env is gitignored; keys never enter the repo.
# For deployment (day 4+), these same vars move into the Railway service env.

# --- LiveKit Cloud (framework transport, ADR-005) - cloud.livekit.io, free tier fine
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Qwen 3.7 Flash via OpenRouter (LLM, ADR-016 amended) - openrouter.ai
# Single provider behind this slug (Alibaba Cloud International), direct forward.
# Day 1 MUST confirm thinking is actually off through the proxy (no reasoning
# tokens in usage) and measure TTFT; fallback = direct DashScope or another
# model slug on this same key.
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.7-flash

# What OpenRouter may answer with when the primary cannot. Comma separated, in
# priority order, and an empty value switches it off entirely.
#
# It is here because LLM_MODEL has exactly ONE endpoint on OpenRouter (Alibaba),
# so provider routing has nothing to route to and a rate limit on that shared
# pool has no way around it. Measured on the 2026-09-08 call: eleven HTTP 429s
# across six of twelve turns, TTFT rising by roughly 685ms per 429, and the
# worst turn spending three of its four retry attempts before it answered. No
# turn actually failed - this is headroom, not a fix for a broken call.
#
# Two things worth knowing before changing it. The fallback slug does NOT
# support prompt caching, so a turn it serves costs about eight times a cached
# one - which is $0.0038 against $0.00046, so it is not a reason to leave it
# empty. And its latency has never been measured here, which is only acceptable
# because a fallback runs exclusively on a turn the primary has already failed:
# the comparison is an unmeasured answer against no answer.
#
# The real fix for the rate limit is a provider key of our own (BYOK), which
# takes it out of OpenRouter's shared pool. That needs a vendor account.
LLM_FALLBACK_MODELS=qwen/qwen3-next-80b-a3b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_THINKING=off               # never on for the voice path (ADR-016)
BRIEF_MODEL=qwen/qwen3.7-flash

# --- STT (ADR-017) - Deepgram nova-3 streaming. Key in the Deepgram block below.
# deepgram: 258-327ms after endpoint, hears "Binghatti", returns figures as
#   digits. This is the recogniser; the latency budget in docs/04- assumes it.
# openrouter: the retired whole-utterance path (ADR-015), kept selectable and
#   tested. p50 1081ms / p90 2826ms after endpoint, "Bint Jbeil" for the
#   client's own name, figures as words that ADR-011's confirmation cannot
#   parse. Runs on the OPENROUTER_API_KEY above and needs no new account, which
#   is the one reason to reach for it.
#
# STT_ENABLED is a real line and not a comment because it defaults to FALSE in
# code (adapter/config.py), and with it off preflight does not ask for
# DEEPGRAM_API_KEY - so a hosted worker could register with every secret pasted
# and still be deaf, which looks like a working deploy. A worker (start/dev/
# connect) now REFUSES to start unless this is set to a recognised true or
# false, so leaving it out, blank, or misspelled is an error rather than
# silence. Set it to false to run text-only on purpose; console mode never
# needs it.
STT_ENABLED=true
STT_PROVIDER=deepgram

# Mid-call switching of the REPLY language, off by default and dormant here.
# It only works on Soniox, which is the recogniser that reports which language
# was spoken, so a worker with this true and STT_PROVIDER left at deepgram now
# REFUSES to start naming both settings - it used to start, register, look
# healthy and raise on the first buyer call instead.
#
# Turning it on is not enough to make it visible, and no variable makes it
# visible either. A switch target has to clear TWO independent gates, and today
# English is the only language that clears both:
#   - a native-authored disclosure in data/disclosures.yaml. `en` is the only
#     entry with copy in it. ALLOW_UNCERTIFIED_LANGUAGE=true overrides THIS one,
#     by speaking the English disclosure and saying so on the event stream.
#   - authored closing phrases in data/farewells.yaml, so the buyer can end the
#     call in the language they are now being answered in. `en` is again the
#     only entry with any. NOTHING OVERRIDES THIS ONE - it is not tied to
#     ALLOW_UNCERTIFIED_LANGUAGE, because a call the buyer cannot end is worse
#     than a call that stays in English.
# So with today's copy the only switch that can happen is the one back TO
# English, and flipping ALLOW_UNCERTIFIED_LANGUAGE does not change that. What
# changes it is authoring copy in those two files.
AUTO_LANGUAGE_SWITCH=false
SONIOX_API_KEY=                  # required when STT_PROVIDER=soniox
SONIOX_MODEL=stt-rt-v5           # optional; this is the default in code
STT_MODEL_DEFAULT=qwen/qwen3-asr-1.7b   # openrouter path only
STT_MODEL_AR=                  # openrouter path only, and leave it empty: ADR-015's day-0 bake-off
                               # (1.7b vs flash vs whisper) was retired with the path, so nothing
                               # will fill it. Arabic dialect handling is DEEPGRAM_MODEL now

# --- Fish Audio (TTS, ADR-014) - fish.audio
# s2.1-pro-free for development; the paid tier for the demo (SLA + commercial licence).
FISH_API_KEY=
TTS_PROVIDER=fishaudio
FISH_TTS_MODEL=s2.1-pro
# Voice reference ids. PROVISIONAL - the top register match in each language's
# shortlist (docs/voice-shortlist.md), not a choice made by ear. The client
# picks at the meeting from two candidates per language; replace these then.
# Must match the defaults in adapter/config.py, because a bare `KEY=` here is
# an empty value that OVERRIDES the code default rather than falling through
# to it. A test loads this file and checks the two agree.
TTS_VOICE_ID_EN=536d3a5e000945adb7038665781a4aca   # "Ethan", Fish Official
TTS_VOICE_ID_AR=10c5c2a37a284a81bb0cf3c53955d795   # Gulf-accented, community upload
TTS_VOICE_ID_HI=6209a5682085409fa935f901f0bce950   # "neel", community upload

# --- Modes
GUARDRAIL_MODE=enforce         # enforce | warn (demo toggle)
PROMPT_MODE=ambassador         # ambassador | naive (demo toggle)
DEMO_MODE=false

# Opens a call in a language with no native-authored disclosure in
# data/disclosures.yaml, falling back to the English notice and saying so on
# the event stream. Off by default: the AI disclosure is the one thing a call
# may not open without, so an unreviewed language refuses to start instead.
# Turn it on to demo Arabic degrading gracefully, which docs/04- argues reads
# better than quietly avoiding Arabic.
ALLOW_UNCERTIFIED_LANGUAGE=false

# The language a call runs in when the room carries none. On the hosted demo the
# visitor picks and the choice arrives in room metadata as
# {"v":1,"language":"en"|"ar"|"hi"}, so this is the FALLBACK, used whenever that
# is absent or unreadable - which is every laptop run and every console run.
LANGUAGE=en                    # en | ar | hi | ru | fr | es | pt | zh | ja | de

# Hard stop for a single call, in seconds. 0 disables it, which is what a
# laptop demo wants: a presenter ends the call by closing it.
# Set it on the hosted service, where the URL is public and every minute of an
# abandoned open tab bills Deepgram, Fish and OpenRouter (docs/09-). Anything
# unreadable here refuses to start rather than reading as "no cap".
DEMO_MAX_CALL_SECONDS=0

# --- Deepgram (STT, ADR-017) - console.deepgram.com
# Required whenever STT_ENABLED is set and STT_PROVIDER is deepgram, which is
# the default. Streaming means partials arrive during speech, so only the tail
# after endpoint is charged - which is what the latency budget in docs/04-
# assumes. Also gives keyterm boosting (the client's own name) and numerals
# (figures as digits, not words). Starting without it fails at preflight and
# names the two alternatives; it never quietly falls back to the slower path.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Phase 2 lead store (ADR-018, docs/10-) - server-side only
# All three are OPTIONAL. With DATABASE_URL empty the worker runs exactly as it
# did before Phase 2 and says so once with `lead_store_disabled`; the console
# and the eval harness need no database. Setting DATABASE_URL with either key
# missing is refused at startup, because a half-configured store would either
# write buyer text in the clear or fail once per call.
#
# DATABASE_URL is the Supabase SESSION pooler URI: host pooler.supabase.com,
# port 5432, user postgres.<project ref>. The direct host (db.<ref>.supabase.co)
# and the transaction port (6543) are both refused - see adapter/session_mode.py.
DATABASE_URL=
# The session-analysis model. Empty means "the same as BRIEF_MODEL": both read a
# transcript and return validated JSON, so they only need to differ when one
# upstream quota is exhausted - which is exactly what happened on 2026-09-03.
ANALYSIS_MODEL=
# Any string of at least 32 CHARACTERS; the working key is derived with
# HKDF-SHA256 per variable name, so the same value in both is still two keys.
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
