# Copy to agent/.env and fill. .env is gitignored; keys never enter the repo.
# For deployment (day 4+), these same vars move into the Railway service env.

# --- LiveKit Cloud (framework transport, ADR-005) - cloud.livekit.io, free tier fine
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Qwen 3.7 Flash via OpenRouter (LLM, ADR-016 amended) - openrouter.ai
# Single provider behind this slug (Alibaba Cloud International), direct forward.
# Day 1 MUST confirm thinking is actually off through the proxy (no reasoning
# tokens in usage) and measure TTFT; fallback = direct DashScope or another
# model slug on this same key.
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.7-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_THINKING=off               # never on for the voice path (ADR-016)
BRIEF_MODEL=qwen/qwen3.7-flash

# --- Qwen3-ASR via OpenRouter (STT, ADR-015 amended) - same OPENROUTER_API_KEY as the LLM
# Transcription endpoint: POST /api/v1/audio/transcriptions (base64 audio in).
# Day 0 head-to-head (1.7b vs qwen3-asr-flash vs whisper) runs on this same key.
# Flash does not support Hindi - it can only take the Arabic slot.
STT_PROVIDER=openrouter
STT_MODEL_DEFAULT=qwen/qwen3-asr-1.7b
STT_MODEL_AR=                  # set after day 0: qwen3-asr-1.7b | qwen3-asr-flash | whisper

# --- Fish Audio (TTS, ADR-014) - fish.audio
# s2.1-pro-free for development; the paid tier for the demo (SLA + commercial licence).
FISH_API_KEY=
TTS_PROVIDER=fishaudio
FISH_TTS_MODEL=s2.1-pro
TTS_VOICE_ID_EN=               # voice reference ids, chosen by ear (day 0/1)
TTS_VOICE_ID_AR=
TTS_VOICE_ID_HI=

# --- Modes
GUARDRAIL_MODE=enforce         # enforce | warn (demo toggle)
PROMPT_MODE=ambassador         # ambassador | naive (demo toggle)
DEMO_MODE=false

# --- Deepgram (streaming STT alternative to the whole-utterance path)
# Set STT_PROVIDER=deepgram to use it. Streaming means partials arrive during
# speech, so only the tail after endpoint is charged - which is what the
# latency budget in docs/04- assumes. Also gives keyterm boosting (the client's
# own name) and numerals (figures as digits, not words).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
